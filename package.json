{
  "name": "falconv",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "dotenv -e .env -o -- pnpm --filter @falconv/db generate",
    "db:migrate": "dotenv -e .env -o -- pnpm --filter @falconv/db migrate:dev",
    "db:migrate:deploy": "dotenv -e .env -o -- pnpm --filter @falconv/db migrate:deploy",
    "db:seed": "dotenv -e .env -o -- pnpm --filter @falconv/db seed",
    "db:studio": "dotenv -e .env -o -- pnpm --filter @falconv/db studio"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}
