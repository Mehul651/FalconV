# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001

# Docker Compose Postgres is typically localhost:5432. If another Postgres already
# uses 5432, point this at the instance that contains FalconV application tables.
DATABASE_URL=postgresql://falconv:falconv@localhost:5432/falconv?schema=public

BETTER_AUTH_SECRET=replace-with-a-32-char-or-longer-secret
BETTER_AUTH_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=
UPLOAD_DIR=uploads

# Only used by `pnpm db:seed` when no Super Admin exists. Leave empty on existing environments.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Set true only for local demo banners. Never invent production KPI numbers.
DEMO_DATA=true
